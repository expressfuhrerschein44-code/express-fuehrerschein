generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auth_sessions {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique(map: "uq_auth_sessions_token_hash") @db.Char(64)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_sessions_user")

  @@index([expires_at], map: "idx_auth_sessions_expires_at")
  @@index([user_id], map: "idx_auth_sessions_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model email_verifications {
  id           String    @id @db.Uuid
  user_id      String    @db.Uuid
  email        String    @db.VarChar(254)
  code_hash    String    @db.Char(64)
  expires_at   DateTime  @db.Timestamptz(6)
  attempts     Int       @default(0) @db.SmallInt
  resend_count Int       @default(0) @db.SmallInt
  last_sent_at DateTime  @default(now()) @db.Timestamptz(6)
  used_at      DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_email_verifications_user")

  @@index([created_at(sort: Desc)], map: "idx_email_verifications_created_at")
  @@index([expires_at], map: "idx_email_verifications_expires_at")
  @@index([user_id], map: "idx_email_verifications_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model oauth_accounts {
  id                  String   @id @db.Uuid
  user_id             String   @db.Uuid
  provider            String   @db.VarChar(16)
  provider_account_id String   @db.VarChar(255)
  email               String   @db.VarChar(254)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_oauth_accounts_user")

  @@unique([provider, provider_account_id], map: "uq_oauth_accounts_provider_identity")
  @@unique([user_id, provider], map: "uq_oauth_accounts_user_provider")
  @@index([user_id], map: "idx_oauth_accounts_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model password_reset_requests {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  code_hash      String    @db.Char(64)
  expires_at     DateTime  @db.Timestamptz(6)
  attempts       Int       @default(0) @db.SmallInt
  resend_count   Int       @default(0) @db.SmallInt
  last_sent_at   DateTime  @default(now()) @db.Timestamptz(6)
  verified_at    DateTime? @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)
  invalidated_at DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_password_reset_requests_created_at")
  @@index([expires_at], map: "idx_password_reset_requests_expires_at")
  @@index([user_id], map: "idx_password_reset_requests_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model registration_rate_limits {
  id                BigInt   @id @default(autoincrement())
  identifier_hash   String   @db.Char(64)
  scope             String   @db.VarChar(32)
  request_count     Int      @default(0)
  window_started_at DateTime @db.Timestamptz(6)
  expires_at        DateTime @db.Timestamptz(6)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([identifier_hash, scope, window_started_at], map: "uq_registration_rate_limit_window")
  @@index([expires_at], map: "idx_registration_rate_limits_expires_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                      String                    @id @db.Uuid
  first_name              String                    @db.VarChar(80)
  last_name               String                    @db.VarChar(80)
  email                   String                    @db.VarChar(254)
  phone_e164              String                    @unique(map: "uq_users_phone_e164") @db.VarChar(16)
  country_code            String                    @db.Char(2)
  password_hash           String
  accepted_terms_at       DateTime                  @db.Timestamptz(6)
  email_verified_at       DateTime?                 @db.Timestamptz(6)
  status                  String                    @default("pending_verification") @db.VarChar(32)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  auth_sessions           auth_sessions[]
  email_verifications     email_verifications[]
  oauth_accounts          oauth_accounts[]
  password_reset_requests password_reset_requests[]

  // Admin-space target relations.
  // Client accounts can receive internal admin notes and can appear as
  // targets in the back-office audit trail. Admin identities themselves
  // are intentionally stored separately in admin_users.
  admin_customer_notes    admin_customer_notes[] @relation("AdminCustomerNoteUser")
  admin_audit_logs_target admin_audit_logs[]     @relation("AdminAuditTargetUser")

  // Client-space relations
  user_profile         user_profiles?
  user_license_classes user_license_classes[]
  user_notifications   user_notifications[]
  user_appointments    user_appointments[]
  user_documents       user_documents[]
  conversations        conversations[]
  subscriptions        subscriptions[]
  payments             payments[]

  // Driving-license application relations
  driving_license_applications driving_license_applications[]
  application_documents        application_documents[]

  @@index([country_code], map: "idx_users_country_code")
  @@index([created_at(sort: Desc)], map: "idx_users_created_at")
  @@index([status], map: "idx_users_status")
}

/**
 * ==========================================================================
 * CLIENT SPACE FOUNDATION
 * ==========================================================================
 */

/// One-to-one client profile/preferences attached to the authentication user.
model user_profiles {
  user_id                 String    @id @db.Uuid
  preferred_locale        String    @default("de") @db.VarChar(8)
  timezone                String    @default("Europe/Berlin") @db.VarChar(64)
  avatar_path             String?   @db.VarChar(512)
  onboarding_completed_at DateTime? @db.Timestamptz(6)
  last_seen_at            DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_profiles_user")

  @@index([preferred_locale], map: "idx_user_profiles_preferred_locale")
}

/// Driving-license class selected by a user.
/// A user may prepare more than one class over time.
model user_license_classes {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  license_class_code String    @db.VarChar(8)
  status             String    @default("active") @db.VarChar(24)
  is_primary         Boolean   @default(false)
  started_at         DateTime  @default(now()) @db.Timestamptz(6)
  target_exam_date   DateTime? @db.Date
  completed_at       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users                  users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_license_classes_user")
  learning_progress      learning_progress?
  learning_days          learning_days[]
  user_topic_progress    user_topic_progress[]
  user_question_progress user_question_progress[]
  training_sessions      training_sessions[]
  exam_attempts          exam_attempts[]
  user_appointments      user_appointments[]

  user_lesson_progress      user_lesson_progress[]
  theory_question_favorites theory_question_favorites[]
  theory_question_notes     theory_question_notes[]
  theory_question_reports   theory_question_reports[]
  theory_study_sessions     theory_study_sessions[]

  @@unique([user_id, license_class_code], map: "uq_user_license_classes_user_class")
  @@index([user_id, status], map: "idx_user_license_classes_user_status")
  @@index([license_class_code], map: "idx_user_license_classes_code")
}

/// Aggregated progress used by the dashboard and the 21-day program.
model learning_progress {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @unique(map: "uq_learning_progress_user_license_class") @db.Uuid
  current_day           Int       @default(1) @db.SmallInt
  completed_days        Int       @default(0) @db.SmallInt
  completed_lessons     Int       @default(0)
  answered_questions    Int       @default(0)
  correct_answers       Int       @default(0)
  readiness_score       Int       @default(0) @db.SmallInt
  total_study_minutes   Int       @default(0)
  last_activity_at      DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_learning_progress_user_license_class")

  @@index([readiness_score], map: "idx_learning_progress_readiness_score")
  @@index([last_activity_at(sort: Desc)], map: "idx_learning_progress_last_activity")
}

/// Per-day state for the Express-Führerschein 21-day learning program.
model learning_days {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  day_number            Int       @db.SmallInt
  status                String    @default("locked") @db.VarChar(24)
  planned_date          DateTime? @db.Date
  started_at            DateTime? @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  study_minutes         Int       @default(0)
  score                 Int?      @db.SmallInt
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_learning_days_user_license_class")

  @@unique([user_license_class_id, day_number], map: "uq_learning_days_user_class_day")
  @@index([user_license_class_id, status], map: "idx_learning_days_user_class_status")
  @@index([planned_date], map: "idx_learning_days_planned_date")
}

/// In-app notifications displayed inside the client area.
model user_notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @default("info") @db.VarChar(32)
  title      String    @db.VarChar(160)
  message    String    @db.Text
  href       String?   @db.VarChar(512)
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_notifications_user")

  @@index([user_id, read_at, created_at(sort: Desc)], map: "idx_user_notifications_user_read_created")
  @@index([created_at(sort: Desc)], map: "idx_user_notifications_created_at")
}

/**
 * ==========================================================================
 * CLIENT PLATFORM + DASHBOARD DATA FOUNDATION
 * ==========================================================================
 * These models provide real persistent data for:
 * - Dashboard metrics;
 * - Theorie / training progress;
 * - exam simulations;
 * - appointments;
 * - client document uploads;
 * - Nachrichten / support conversations;
 * - subscriptions and payments.
 * Binary documents/images/PDFs are NOT stored in PostgreSQL.
 * user_documents stores only metadata and the Supabase Storage object path.
 * ==========================================================================
 */

/// Language-neutral theory topic identity.
model theory_topics {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  license_class_code String   @db.VarChar(8)
  slug               String   @db.VarChar(96)
  sort_order         Int      @default(0)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  country_code      String                      @db.Char(2)
  program_id        String                      @db.Uuid
  translations      theory_topic_translations[]
  questions         theory_questions[]
  user_progress     user_topic_progress[]
  training_sessions training_sessions[]

  theory_programs theory_programs  @relation(fields: [program_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_theory_topics_program")
  lessons         theory_lessons[]

  @@unique([program_id, slug], map: "uq_theory_topics_program_slug")
  // Country/program indexes are also created by the SQL migration.
  @@index([country_code, license_class_code, is_active, sort_order], map: "idx_theory_topics_country_class_active_order")
  @@index([program_id, is_active, sort_order], map: "idx_theory_topics_program_active_order")
  @@index([license_class_code, is_active, sort_order], map: "idx_theory_topics_class_active_order")
}

/// Localized title/description for a theory topic.
model theory_topic_translations {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_id    String   @db.Uuid
  locale      String   @db.VarChar(8)
  title       String   @db.VarChar(160)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  theory_topics theory_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_topic_translations_topic")

  @@unique([topic_id, locale], map: "uq_theory_topic_translations_topic_locale")
  @@index([locale], map: "idx_theory_topic_translations_locale")
}

/// Language-neutral theory question identity.
model theory_questions {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_id           String   @db.Uuid
  external_ref       String?  @db.VarChar(128)
  question_type      String   @default("single_choice") @db.VarChar(32)
  penalty_points     Int      @default(0) @db.SmallInt
  media_storage_path String?  @db.VarChar(768)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  status               String                         @default("published") @db.VarChar(24)
  version              Int                            @default(1)
  difficulty           String                         @default("standard") @db.VarChar(24)
  valid_from           DateTime?                      @db.Date
  valid_until          DateTime?                      @db.Date
  published_at         DateTime?                      @db.Timestamptz(6)
  theory_topics        theory_topics                  @relation(fields: [topic_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_theory_questions_topic")
  translations         theory_question_translations[]
  user_progress        user_question_progress[]
  exam_attempt_answers exam_attempt_answers[]

  versions              theory_question_versions[]
  lesson_content_blocks theory_lesson_content_blocks[]
  favorites             theory_question_favorites[]
  notes                 theory_question_notes[]
  reports               theory_question_reports[]

  @@unique([topic_id, external_ref], map: "uq_theory_questions_topic_external_ref")
  @@index([topic_id, is_active], map: "idx_theory_questions_topic_active")
}

/// Localized question text, answers and explanation.
/// JSON supports single-choice, multiple-choice and richer future formats.
model theory_question_translations {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id    String   @db.Uuid
  locale         String   @db.VarChar(8)
  prompt         String   @db.Text
  explanation    String?  @db.Text
  answer_options Json?
  correct_answer Json?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  theory_questions theory_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_translations_question")

  @@unique([question_id, locale], map: "uq_theory_question_translations_question_locale")
  @@index([locale], map: "idx_theory_question_translations_locale")
}

/// Per-user progress for each theory topic.
model user_topic_progress {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  topic_id              String    @db.Uuid
  answered_questions    Int       @default(0)
  correct_answers       Int       @default(0)
  incorrect_answers     Int       @default(0)
  progress_percent      Int       @default(0) @db.SmallInt
  mastery_score         Int       @default(0) @db.SmallInt
  last_trained_at       DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_topic_progress_user_license_class")
  theory_topics        theory_topics        @relation(fields: [topic_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_topic_progress_topic")

  @@unique([user_license_class_id, topic_id], map: "uq_user_topic_progress_user_class_topic")
  @@index([user_license_class_id, progress_percent], map: "idx_user_topic_progress_user_class_progress")
  @@index([last_trained_at(sort: Desc)], map: "idx_user_topic_progress_last_trained")
}

/// Per-user/question history used for mistakes, mastery and dashboard metrics.
model user_question_progress {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  question_id           String    @db.Uuid
  attempt_count         Int       @default(0)
  correct_count         Int       @default(0)
  incorrect_count       Int       @default(0)
  last_answer_correct   Boolean?
  is_mastered           Boolean   @default(false)
  needs_review          Boolean   @default(false)
  last_answered_at      DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_question_progress_user_license_class")
  theory_questions     theory_questions     @relation(fields: [question_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_question_progress_question")

  @@unique([user_license_class_id, question_id], map: "uq_user_question_progress_user_class_question")
  @@index([user_license_class_id, needs_review], map: "idx_user_question_progress_review")
  @@index([last_answered_at(sort: Desc)], map: "idx_user_question_progress_last_answered")
}

/// Historical training activity used by "Zuletzt trainiert" and analytics.
model training_sessions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  topic_id              String?   @db.Uuid
  session_type          String    @default("mixed") @db.VarChar(32)
  questions_answered    Int       @default(0)
  correct_answers       Int       @default(0)
  incorrect_answers     Int       @default(0)
  score_percent         Int?      @db.SmallInt
  duration_seconds      Int       @default(0)
  started_at            DateTime  @default(now()) @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_training_sessions_user_license_class")
  theory_topics        theory_topics?       @relation(fields: [topic_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_training_sessions_topic")

  @@index([user_license_class_id, started_at(sort: Desc)], map: "idx_training_sessions_user_class_started")
  @@index([topic_id], map: "idx_training_sessions_topic")
}

/// Exam simulation/attempt header.
model exam_attempts {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  attempt_type          String    @default("theory_simulation") @db.VarChar(32)
  status                String    @default("in_progress") @db.VarChar(24)
  total_questions       Int       @default(0)
  answered_questions    Int       @default(0)
  correct_answers       Int       @default(0)
  incorrect_answers     Int       @default(0)
  penalty_points        Int       @default(0)
  score_percent         Int?      @db.SmallInt
  passed                Boolean?
  started_at            DateTime  @default(now()) @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  exam_configuration_id  String?                @db.Uuid
  configuration_snapshot Json?
  user_license_classes   user_license_classes   @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exam_attempts_user_license_class")
  answers                exam_attempt_answers[]

  exam_configurations exam_configurations? @relation(fields: [exam_configuration_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_exam_attempts_configuration")

  @@index([exam_configuration_id], map: "idx_exam_attempts_configuration")
  @@index([user_license_class_id, started_at(sort: Desc)], map: "idx_exam_attempts_user_class_started")
  @@index([user_license_class_id, status], map: "idx_exam_attempts_user_class_status")
  @@index([user_license_class_id, passed], map: "idx_exam_attempts_user_class_passed")
}

/// Question-level answers retained for exam review and mistake analysis.
model exam_attempt_answers {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_attempt_id String   @db.Uuid
  question_id     String   @db.Uuid
  answer_payload  Json?
  is_correct      Boolean?
  penalty_points  Int      @default(0) @db.SmallInt
  answered_at     DateTime @default(now()) @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  exam_attempts    exam_attempts    @relation(fields: [exam_attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exam_attempt_answers_attempt")
  theory_questions theory_questions @relation(fields: [question_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_exam_attempt_answers_question")

  @@unique([exam_attempt_id, question_id], map: "uq_exam_attempt_answers_attempt_question")
  @@index([question_id], map: "idx_exam_attempt_answers_question")
}

/// Client appointments: exams, driving lessons and school appointments.
model user_appointments {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid
  user_license_class_id String?   @db.Uuid
  appointment_type      String    @default("other") @db.VarChar(32)
  title                 String    @db.VarChar(160)
  location              String?   @db.VarChar(255)
  starts_at             DateTime  @db.Timestamptz(6)
  ends_at               DateTime? @db.Timestamptz(6)
  status                String    @default("scheduled") @db.VarChar(24)
  notes                 String?   @db.Text

  // Admin workflow for Praxis / Termine.
  managed_by_admin_id String?   @db.Uuid
  admin_notes         String?   @db.Text
  confirmed_at        DateTime? @db.Timestamptz(6)
  cancelled_at        DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users                users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_appointments_user")
  user_license_classes user_license_classes? @relation(fields: [user_license_class_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user_appointments_user_license_class")
  managed_by_admin     admin_users?          @relation("AppointmentManagedByAdmin", fields: [managed_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user_appointments_managed_by_admin")

  @@index([user_id, starts_at], map: "idx_user_appointments_user_starts")
  @@index([user_id, status, starts_at], map: "idx_user_appointments_user_status_starts")
  @@index([user_license_class_id], map: "idx_user_appointments_user_license_class")
  @@index([managed_by_admin_id, status, starts_at], map: "idx_user_appointments_admin_status_starts")
}

/// Metadata for client-uploaded files.
/// Actual PDF/image bytes live in a private Supabase Storage bucket.
model user_documents {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @db.Uuid
  document_type        String    @default("other") @db.VarChar(32)
  title                String?   @db.VarChar(160)
  original_filename    String    @db.VarChar(255)
  storage_bucket       String    @db.VarChar(63)
  storage_path         String    @db.VarChar(768)
  preview_storage_path String?   @db.VarChar(768)
  mime_type            String    @db.VarChar(100)
  file_size_bytes      BigInt
  checksum_sha256      String?   @db.Char(64)
  status               String    @default("uploaded") @db.VarChar(24)
  rejection_reason     String?   @db.Text
  expires_on           DateTime? @db.Date
  uploaded_at          DateTime  @default(now()) @db.Timestamptz(6)
  verified_at          DateTime? @db.Timestamptz(6)
  rejected_at          DateTime? @db.Timestamptz(6)
  deleted_at           DateTime? @db.Timestamptz(6)

  // Admin who last verified/rejected the document.
  reviewed_by_admin_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_documents_user")
  reviewed_by_admin     admin_users?            @relation("UserDocumentReviewedByAdmin", fields: [reviewed_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user_documents_reviewed_by_admin")
  conversation_messages conversation_messages[]

  @@unique([storage_bucket, storage_path], map: "uq_user_documents_storage_object")
  @@index([user_id, status, created_at(sort: Desc)], map: "idx_user_documents_user_status_created")
  @@index([user_id, document_type], map: "idx_user_documents_user_type")
  @@index([reviewed_by_admin_id, status, created_at(sort: Desc)], map: "idx_user_documents_admin_status_created")
}

/// Client/support conversation container for "Nachrichten" and support.
model conversations {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  conversation_type String    @default("general") @db.VarChar(24)
  subject           String?   @db.VarChar(200)
  status            String    @default("open") @db.VarChar(24)
  last_message_at   DateTime? @db.Timestamptz(6)
  closed_at         DateTime? @db.Timestamptz(6)

  // Optional support assignment in the admin space.
  assigned_admin_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users          users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversations_user")
  assigned_admin admin_users?            @relation("ConversationAssignedAdmin", fields: [assigned_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_conversations_assigned_admin")
  messages       conversation_messages[]

  @@index([user_id, status, last_message_at(sort: Desc)], map: "idx_conversations_user_status_last_message")
  @@index([assigned_admin_id, status, last_message_at(sort: Desc)], map: "idx_conversations_admin_status_last_message")
}

/// Individual message in a client/support conversation.
model conversation_messages {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id        String    @db.Uuid
  sender_type            String    @db.VarChar(16)
  sender_user_id         String?   @db.Uuid
  sender_admin_id        String?   @db.Uuid
  body                   String?   @db.Text
  attachment_document_id String?   @db.Uuid
  read_at                DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  conversations  conversations   @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversation_messages_conversation")
  sender_admin   admin_users?    @relation("ConversationMessageSenderAdmin", fields: [sender_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_conversation_messages_sender_admin")
  user_documents user_documents? @relation(fields: [attachment_document_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_conversation_messages_document")

  @@index([conversation_id, created_at], map: "idx_conversation_messages_conversation_created")
  @@index([conversation_id, read_at], map: "idx_conversation_messages_conversation_read")
  @@index([attachment_document_id], map: "idx_conversation_messages_document")
  @@index([sender_admin_id, created_at(sort: Desc)], map: "idx_conversation_messages_sender_admin_created")
}

/// Subscription state for the client's chosen plan.
model subscriptions {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  plan_code                String    @db.VarChar(64)
  provider                 String    @db.VarChar(32)
  provider_customer_id     String?   @db.VarChar(255)
  provider_subscription_id String?   @unique(map: "uq_subscriptions_provider_subscription_id") @db.VarChar(255)
  status                   String    @default("active") @db.VarChar(24)
  current_period_start     DateTime? @db.Timestamptz(6)
  current_period_end       DateTime? @db.Timestamptz(6)
  cancel_at_period_end     Boolean   @default(false)
  canceled_at              DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users    users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscriptions_user")
  payments payments[]

  @@index([user_id, status], map: "idx_subscriptions_user_status")
  @@index([provider, provider_customer_id], map: "idx_subscriptions_provider_customer")
}

/// Payment ledger displayed in the client payment area.
/// The same ledger can keep provider/subscription payments and
/// admin-activated bank-transfer steps for driving-license applications.
/// Bank details are stored as a per-payment snapshot so later admin changes
/// never alter the historical instructions of an existing payment.
model payments {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String  @db.Uuid
  subscription_id     String? @db.Uuid
  application_id      String? @db.Uuid
  provider            String  @db.VarChar(32)
  provider_payment_id String? @unique(map: "uq_payments_provider_payment_id") @db.VarChar(255)
  payment_stage       String? @db.VarChar(64)
  stage_order         Int     @default(0)
  payment_reference   String? @db.VarChar(128)
  amount_cents        Int
  currency            String  @default("EUR") @db.Char(3)
  status              String  @default("pending") @db.VarChar(24)
  description         String? @db.VarChar(255)

  // Admin-controlled activation/review workflow.
  activated_by_admin_id String?   @db.Uuid
  reviewed_by_admin_id  String?   @db.Uuid
  activated_at          DateTime? @db.Timestamptz(6)
  due_at                DateTime? @db.Timestamptz(6)
  bank_details_snapshot Json?

  proof_storage_bucket    String?   @db.VarChar(63)
  proof_storage_path      String?   @db.VarChar(768)
  proof_original_filename String?   @db.VarChar(255)
  proof_mime_type         String?   @db.VarChar(100)
  proof_file_size_bytes   BigInt?
  proof_submitted_at      DateTime? @db.Timestamptz(6)

  reviewed_at      DateTime? @db.Timestamptz(6)
  rejection_reason String?   @db.Text
  paid_at          DateTime? @db.Timestamptz(6)
  refunded_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users              users                         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_user")
  subscriptions      subscriptions?                @relation(fields: [subscription_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_payments_subscription")
  application        driving_license_applications? @relation(fields: [application_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_payments_application")
  activated_by_admin admin_users?                  @relation("PaymentActivatedByAdmin", fields: [activated_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_payments_activated_by_admin")
  reviewed_by_admin  admin_users?                  @relation("PaymentReviewedByAdmin", fields: [reviewed_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_payments_reviewed_by_admin")

  @@unique([proof_storage_bucket, proof_storage_path], map: "uq_payments_proof_storage_object")
  @@index([user_id, created_at(sort: Desc)], map: "idx_payments_user_created")
  @@index([subscription_id], map: "idx_payments_subscription")
  @@index([application_id, status, stage_order], map: "idx_payments_application_status_order")
  @@index([user_id, status, activated_at(sort: Desc)], map: "idx_payments_user_status_activated")
  @@index([payment_reference], map: "idx_payments_reference")
  @@index([status], map: "idx_payments_status")
  @@index([activated_by_admin_id, activated_at(sort: Desc)], map: "idx_payments_activated_by_admin")
  @@index([reviewed_by_admin_id, reviewed_at(sort: Desc)], map: "idx_payments_reviewed_by_admin")
}

/**
 * ==========================================================================
 * DRIVING-LICENSE APPLICATION
 * ==========================================================================
 * Minimal persistent model for the "Mein Führerschein" application page.
 * - selected_classes stores the chosen license-class codes for the draft;
 * - all money values are stored as integer cents;
 * - uploaded document/signature bytes stay in private Supabase Storage;
 * - PostgreSQL stores only stable Storage object paths, never signed URLs.
 * ==========================================================================
 */

/// One client driving-license application.
/// A draft can be saved and later submitted without creating a second record.
model driving_license_applications {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String   @db.Uuid
  selected_classes     String[] @default([]) @db.VarChar(8)
  theory_passed        Boolean?
  practical_passed     Boolean?
  classes_total_cents  Int      @default(0)
  processing_fee_cents Int      @default(0)
  total_cents          Int      @default(0)
  currency             String   @default("EUR") @db.Char(3)
  signature_type       String?  @db.VarChar(16)
  signature_path       String?  @db.VarChar(768)

  // Human-readable reference shown in the admin/client spaces.
  // Nullable keeps all existing rows valid until references are backfilled.
  application_reference String? @unique(map: "uq_driving_license_applications_reference") @db.VarChar(40)

  status       String    @default("draft") @db.VarChar(24)
  submitted_at DateTime? @db.Timestamptz(6)

  // Admin review/decision.
  reviewed_by_admin_id String?   @db.Uuid
  reviewed_at          DateTime? @db.Timestamptz(6)
  approved_at          DateTime? @db.Timestamptz(6)
  rejected_at          DateTime? @db.Timestamptz(6)
  rejection_reason     String?   @db.Text

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users             users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_driving_license_applications_user")
  reviewed_by_admin admin_users?            @relation("ApplicationReviewedByAdmin", fields: [reviewed_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_driving_license_applications_reviewed_by_admin")
  documents         application_documents[]
  payments          payments[]

  @@index([user_id, status, updated_at(sort: Desc)], map: "idx_driving_license_applications_user_status_updated")
  @@index([submitted_at(sort: Desc)], map: "idx_driving_license_applications_submitted_at")
  @@index([status], map: "idx_driving_license_applications_status")
  @@index([reviewed_by_admin_id, status, submitted_at(sort: Desc)], map: "idx_driving_license_applications_admin_status")
}

/// Metadata for the three application documents.
/// The actual image/PDF bytes live in the private Supabase Storage bucket.
model application_documents {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id    String   @db.Uuid
  user_id           String   @db.Uuid
  document_type     String   @db.VarChar(32)
  storage_bucket    String   @default("driving-license-documents") @db.VarChar(63)
  storage_path      String   @db.VarChar(768)
  original_filename String   @db.VarChar(255)
  mime_type         String   @db.VarChar(100)
  file_size_bytes   BigInt
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  application driving_license_applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_documents_application")
  users       users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_documents_user")

  @@unique([application_id, document_type], map: "uq_application_documents_application_type")
  @@unique([storage_bucket, storage_path], map: "uq_application_documents_storage_object")
  @@index([user_id, created_at(sort: Desc)], map: "idx_application_documents_user_created")
  @@index([application_id], map: "idx_application_documents_application")
  @@index([document_type], map: "idx_application_documents_type")
}

/**
 * ==========================================================================
 * ADMINISTRATION / BACK OFFICE
 * ==========================================================================
 * Admin identities are intentionally separated from client users.
 * They authenticate directly against admin_users and never require a client
 * phone number. Admin sessions stay separated from client auth_sessions.
 * ==========================================================================
 */

/// Administrative identity used only by the back office.
/// No phone number and no client users row are required.
/// legacy_user_id maps the former user_id column and stays nullable only to
/// preserve possible historical data from the first admin foundation.
model admin_users {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacy_user_id String?   @unique(map: "uq_admin_users_user") @map("user_id") @db.Uuid
  email          String    @unique(map: "uq_admin_users_email") @db.VarChar(254)
  password_hash  String
  first_name     String    @db.VarChar(80)
  last_name      String    @db.VarChar(80)
  role           String    @default("admin") @db.VarChar(32)
  is_active      Boolean   @default(true)
  last_login_at  DateTime? @db.Timestamptz(6)
  last_seen_at   DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  sessions                admin_sessions[]
  audit_logs              admin_audit_logs[]
  notifications           admin_notifications[]
  customer_notes          admin_customer_notes[]
  updated_settings        platform_settings[]
  reviewed_applications   driving_license_applications[] @relation("ApplicationReviewedByAdmin")
  activated_payments      payments[]                     @relation("PaymentActivatedByAdmin")
  reviewed_payments       payments[]                     @relation("PaymentReviewedByAdmin")
  managed_appointments    user_appointments[]            @relation("AppointmentManagedByAdmin")
  reviewed_documents      user_documents[]               @relation("UserDocumentReviewedByAdmin")
  assigned_conversations  conversations[]                @relation("ConversationAssignedAdmin")
  sent_messages           conversation_messages[]        @relation("ConversationMessageSenderAdmin")
  resolved_theory_reports theory_question_reports[]      @relation("TheoryReportResolvedByAdmin")

  @@index([role, is_active], map: "idx_admin_users_role_active")
  @@index([is_active, last_seen_at(sort: Desc)], map: "idx_admin_users_active_last_seen")
}

/// Back-office-only session.
/// Token hashes are stored exactly like client sessions, but admin cookies can
/// be isolated from client cookies by the server implementation.
model admin_sessions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id     String    @db.Uuid
  token_hash   String    @unique(map: "uq_admin_sessions_token_hash") @db.Char(64)
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  last_seen_at DateTime? @db.Timestamptz(6)
  ip_hash      String?   @db.Char(64)
  user_agent   String?   @db.VarChar(512)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  admin admin_users @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_sessions_admin")

  @@index([admin_id, expires_at], map: "idx_admin_sessions_admin_expires")
  @@index([expires_at], map: "idx_admin_sessions_expires")
}

/// Immutable-style audit trail for sensitive admin actions.
model admin_audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id       String?  @db.Uuid
  target_user_id String?  @db.Uuid
  action         String   @db.VarChar(80)
  entity_type    String   @db.VarChar(64)
  entity_id      String?  @db.VarChar(128)
  metadata       Json?
  ip_hash        String?  @db.Char(64)
  user_agent     String?  @db.VarChar(512)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  admin       admin_users? @relation(fields: [admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_admin_audit_logs_admin")
  target_user users?       @relation("AdminAuditTargetUser", fields: [target_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_admin_audit_logs_target_user")

  @@index([admin_id, created_at(sort: Desc)], map: "idx_admin_audit_logs_admin_created")
  @@index([target_user_id, created_at(sort: Desc)], map: "idx_admin_audit_logs_target_user_created")
  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "idx_admin_audit_logs_entity_created")
  @@index([action, created_at(sort: Desc)], map: "idx_admin_audit_logs_action_created")
}

/// Back-office notifications.
/// admin_id = null means the notification can be treated as global/broadcast.
model admin_notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id   String?   @db.Uuid
  type       String    @default("info") @db.VarChar(32)
  title      String    @db.VarChar(160)
  message    String    @db.Text
  href       String?   @db.VarChar(512)
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  admin admin_users? @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_notifications_admin")

  @@index([admin_id, read_at, created_at(sort: Desc)], map: "idx_admin_notifications_admin_read_created")
  @@index([type, created_at(sort: Desc)], map: "idx_admin_notifications_type_created")
}

/// Internal notes visible only in the back office.
model admin_customer_notes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  admin_id   String   @db.Uuid
  body       String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user  users       @relation("AdminCustomerNoteUser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_customer_notes_user")
  admin admin_users @relation(fields: [admin_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_admin_customer_notes_admin")

  @@index([user_id, created_at(sort: Desc)], map: "idx_admin_customer_notes_user_created")
  @@index([admin_id, created_at(sort: Desc)], map: "idx_admin_customer_notes_admin_created")
}

/// Non-secret platform configuration editable from the future admin settings UI.
/// Examples: contact information, default bank-transfer templates, support copy.
/// Secrets/API keys must remain in environment variables, never in this table.
model platform_settings {
  key                 String   @id @db.VarChar(128)
  category            String   @default("general") @db.VarChar(64)
  value               Json
  description         String?  @db.Text
  updated_by_admin_id String?  @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  updated_by_admin admin_users? @relation(fields: [updated_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_platform_settings_updated_by_admin")

  @@index([category, updated_at(sort: Desc)], map: "idx_platform_settings_category_updated")
  @@index([updated_by_admin_id], map: "idx_platform_settings_updated_by_admin")
}

model theory_programs {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_code       String    @db.Char(2)
  license_class_code String    @db.VarChar(8)
  code               String    @unique(map: "uq_theory_programs_code") @db.VarChar(96)
  version            String    @db.VarChar(32)
  status             String    @default("draft") @db.VarChar(24)
  is_current         Boolean   @default(false)
  valid_from         DateTime? @db.Date
  valid_until        DateTime? @db.Date
  published_at       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  topics              theory_topics[]
  exam_configurations exam_configurations[]

  @@unique([country_code, license_class_code, version], map: "uq_theory_programs_country_class_version")
  @@index([country_code, license_class_code, status], map: "idx_theory_programs_country_class_status")
}

model theory_question_versions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id String   @db.Uuid
  version     Int
  snapshot    Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  theory_questions theory_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_versions_question")

  @@unique([question_id, version], map: "uq_theory_question_versions_question_version")
  @@index([question_id, created_at(sort: Desc)], map: "idx_theory_question_versions_question_created")
}

model theory_lessons {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_id                   String    @db.Uuid
  slug                       String    @db.VarChar(96)
  sort_order                 Int       @default(0)
  estimated_duration_minutes Int?      @db.SmallInt
  status                     String    @default("draft") @db.VarChar(24)
  version                    Int       @default(1)
  valid_from                 DateTime? @db.Date
  valid_until                DateTime? @db.Date
  published_at               DateTime? @db.Timestamptz(6)
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  theory_topics  theory_topics                  @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_lessons_topic")
  translations   theory_lesson_translations[]
  content_blocks theory_lesson_content_blocks[]
  user_progress  user_lesson_progress[]
  notes          theory_question_notes[]
  study_sessions theory_study_sessions[]

  @@unique([topic_id, slug], map: "uq_theory_lessons_topic_slug")
  @@index([topic_id, status, sort_order], map: "idx_theory_lessons_topic_status_order")
}

model theory_lesson_translations {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id   String   @db.Uuid
  locale      String   @db.VarChar(8)
  title       String   @db.VarChar(180)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  theory_lessons theory_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_lesson_translations_lesson")

  @@unique([lesson_id, locale], map: "uq_theory_lesson_translations_lesson_locale")
  @@index([locale], map: "idx_theory_lesson_translations_locale")
}

model theory_lesson_content_blocks {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id          String   @db.Uuid
  block_type         String   @db.VarChar(32)
  sort_order         Int      @default(0)
  media_storage_path String?  @db.VarChar(768)
  question_id        String?  @db.Uuid
  config_json        Json?
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  theory_lessons   theory_lessons                             @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_lesson_content_blocks_lesson")
  theory_questions theory_questions?                          @relation(fields: [question_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_theory_lesson_content_blocks_question")
  translations     theory_lesson_content_block_translations[]

  @@index([lesson_id, is_active, sort_order], map: "idx_theory_lesson_content_blocks_lesson_order")
  @@index([question_id], map: "idx_theory_lesson_content_blocks_question")
}

model theory_lesson_content_block_translations {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_id     String   @db.Uuid
  locale       String   @db.VarChar(8)
  title        String?  @db.VarChar(180)
  body_text    String?  @db.Text
  content_json Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  theory_lesson_content_blocks theory_lesson_content_blocks @relation(fields: [block_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_lesson_block_translations_block")

  @@unique([block_id, locale], map: "uq_theory_lesson_block_translations_block_locale")
  @@index([locale], map: "idx_theory_lesson_block_translations_locale")
}

model user_lesson_progress {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  lesson_id             String    @db.Uuid
  progress_percent      Int       @default(0) @db.SmallInt
  current_block_index   Int       @default(0)
  completed             Boolean   @default(false)
  started_at            DateTime? @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  last_activity_at      DateTime? @db.Timestamptz(6)
  total_active_seconds  Int       @default(0)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_lesson_progress_user_license_class")
  theory_lessons       theory_lessons       @relation(fields: [lesson_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_lesson_progress_lesson")

  @@unique([user_license_class_id, lesson_id], map: "uq_user_lesson_progress_user_class_lesson")
  @@index([user_license_class_id, last_activity_at(sort: Desc)], map: "idx_user_lesson_progress_user_class_activity")
  @@index([lesson_id], map: "idx_user_lesson_progress_lesson")
}

model theory_question_favorites {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String   @db.Uuid
  question_id           String   @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_favorites_user_license_class")
  theory_questions     theory_questions     @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_favorites_question")

  @@unique([user_license_class_id, question_id], map: "uq_theory_question_favorites_user_class_question")
  @@index([user_license_class_id, created_at(sort: Desc)], map: "idx_theory_question_favorites_user_class_created")
}

model theory_question_notes {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String   @db.Uuid
  question_id           String?  @db.Uuid
  lesson_id             String?  @db.Uuid
  body                  String   @db.Text
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_notes_user_license_class")
  theory_questions     theory_questions?    @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_notes_question")
  theory_lessons       theory_lessons?      @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_notes_lesson")

  @@index([user_license_class_id, created_at(sort: Desc)], map: "idx_theory_question_notes_user_class_created")
  @@index([question_id], map: "idx_theory_question_notes_question")
  @@index([lesson_id], map: "idx_theory_question_notes_lesson")
}

model theory_question_reports {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  question_id           String    @db.Uuid
  reason                String    @db.VarChar(32)
  message               String?   @db.Text
  status                String    @default("open") @db.VarChar(24)
  resolved_by_admin_id  String?   @db.Uuid
  resolved_at           DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_question_reports_user_license_class")
  theory_questions     theory_questions     @relation(fields: [question_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_theory_question_reports_question")
  resolved_by_admin    admin_users?         @relation("TheoryReportResolvedByAdmin", fields: [resolved_by_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_theory_question_reports_resolved_by_admin")

  @@index([user_license_class_id, created_at(sort: Desc)], map: "idx_theory_question_reports_user_class_created")
  @@index([status, created_at(sort: Desc)], map: "idx_theory_question_reports_status_created")
  @@index([resolved_by_admin_id, status, created_at(sort: Desc)], map: "idx_theory_question_reports_admin_status_created")
}

model theory_study_sessions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_license_class_id String    @db.Uuid
  lesson_id             String?   @db.Uuid
  session_type          String    @default("lesson") @db.VarChar(24)
  status                String    @default("active") @db.VarChar(24)
  started_at            DateTime  @default(now()) @db.Timestamptz(6)
  last_activity_at      DateTime  @default(now()) @db.Timestamptz(6)
  ended_at              DateTime? @db.Timestamptz(6)
  active_seconds        Int       @default(0)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user_license_classes user_license_classes @relation(fields: [user_license_class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_theory_study_sessions_user_license_class")
  theory_lessons       theory_lessons?      @relation(fields: [lesson_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_theory_study_sessions_lesson")

  @@index([user_license_class_id, started_at(sort: Desc)], map: "idx_theory_study_sessions_user_class_started")
  @@index([user_license_class_id, status, last_activity_at(sort: Desc)], map: "idx_theory_study_sessions_active")
}

model exam_configurations {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id       String    @db.Uuid
  version          String    @db.VarChar(32)
  question_count   Int       @db.SmallInt
  duration_seconds Int
  scoring_method   String    @db.VarChar(32)
  passing_rule     Json
  status           String    @default("draft") @db.VarChar(24)
  active_from      DateTime? @db.Date
  active_until     DateTime? @db.Date
  published_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  theory_programs theory_programs @relation(fields: [program_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_exam_configurations_program")
  exam_attempts   exam_attempts[]

  @@unique([program_id, version], map: "uq_exam_configurations_program_version")
  @@index([program_id, status, active_from, active_until], map: "idx_exam_configurations_program_status_dates")
}
